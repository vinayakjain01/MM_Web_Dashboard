# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Direct Postgres connection, used only by scripts/run-migrations.mjs
# Percent-encode any special characters in the password (@ -> %40, etc).
# If db.<project-ref>.supabase.co doesn't resolve/connect (common on IPv4-only networks --
# that host is IPv6-only), use the session pooler instead: find your project's pooler
# region on the Supabase dashboard's Connect page, then use:
# postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:<url-encoded-password>@db.<project-ref>.supabase.co:5432/postgres

# --- Google OAuth (Sheets API, read-only) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Generate by running `npm run auth` locally, once.
GOOGLE_OAUTH_REFRESH_TOKEN=

SHEET_SPREADSHEET_ID=

# --- Apps Script image bridge (optional -- see README "Apps Script image bridge") ---
APPS_SCRIPT_IMAGE_BRIDGE_URL=
APPS_SCRIPT_SHARED_SECRET=
